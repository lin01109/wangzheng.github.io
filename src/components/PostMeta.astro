---
import { formatDateToYYYYMMDD } from '../utils/date-utils';
import { getTagUrl } from '../utils/url-utils';
interface Props { class?: string; published: Date; updated?: Date; tags: string[]; category: string|null; hideTagsForMobile?: boolean; hideUpdateDate?: boolean }
const { published, tags } = Astro.props;
---
<div class:list={['article-meta',Astro.props.class]}><time datetime={formatDateToYYYYMMDD(published)}>{formatDateToYYYYMMDD(published)}</time>{tags.map(tag=><a href={getTagUrl(tag)} class="tag-chip">#{tag}</a>)}</div>